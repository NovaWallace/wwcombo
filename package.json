{
  "name": "wuthering-combo-trainer",
  "version": "0.65.0",
  "private": true,
  "license": "MIT",
  "description": "Desktop combo trainer for Wuthering Waves.",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "tauri:dev": "cargo tauri dev",
    "build": "tsc -b && vite build",
    "tauri:build": "cargo tauri build",
    "android:build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-android-debug.ps1",
    "package:dlc": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-dlc.ps1",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-portable.ps1",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "community:init": "node scripts/community/community-combos.mjs init",
    "community:auto": "node scripts/community/community-combos.mjs auto",
    "community:mail": "node scripts/community/community-combos.mjs mail",
    "community:ingest": "node scripts/community/community-combos.mjs ingest",
    "community:publish": "node scripts/community/community-combos.mjs publish",
    "community:index": "node scripts/community/community-combos.mjs index",
    "community:deploy": "node scripts/community/community-combos.mjs deploy",
    "community:package-server": "node scripts/community/package-server.mjs",
    "community:web": "node scripts/community/server.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "latest",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.3",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "imapflow": "^1.5.0",
    "mailparser": "^3.9.14"
  }
}
