{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WW Combo Trainer",
  "version": "0.62.0",
  "identifier": "com.novawallace.wwcombo",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WW Combo Trainer",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": ["resources/ffmpeg.exe"]
  }
}
